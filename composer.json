{
    "name": "jooservices/laravel-notifications",
    "description": "Laravel notification transport for Telegram, Slack, and email — send-only channel adapters with pre-rendered messages (no templates, queue, or logging).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "email",
        "jooservices",
        "laravel",
        "laravel12",
        "laravel13",
        "mail",
        "notifications",
        "php",
        "php85",
        "slack",
        "telegram"
    ],
    "authors": [
        {
            "name": "Viet Vu",
            "email": "jooservices@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jooservices/laravel-notifications/issues",
        "source": "https://github.com/jooservices/laravel-notifications"
    },
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "jooservices/client": "^4.0",
        "jooservices/dto": "^3.2",
        "jooservices/exceptions": "^4.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.23",
        "captainhook/plugin-composer": "^5.3",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.65",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\LaravelNotifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\LaravelNotifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JOOservices\\LaravelNotifications\\LaravelNotificationsServiceProvider"
            ],
            "aliases": {
                "Notification": "JOOservices\\LaravelNotifications\\Facades\\Notification"
            }
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --no-coverage",
        "test:coverage": "phpunit -c phpunit.xml --coverage-text --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html",
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan",
            "@lint:phpmd",
            "@lint:cs"
        ],
        "lint:fix": [
            "@lint:pint:fix",
            "@lint:cs:fix"
        ],
        "check": [
            "@lint",
            "@test"
        ],
        "ci": [
            "@lint",
            "@test:coverage"
        ],
        "post-install-cmd": "captainhook install --force --skip-existing",
        "post-update-cmd": "captainhook install --force --skip-existing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true
        },
        "audit": {
            "abandoned": "ignore"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
